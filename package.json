{
  "name": "privacy-mask-video",
  "version": "0.1.3",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Evan Hyer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evan-hyer/privacy-mask-video.git"
  },
  "homepage": "https://github.com/evan-hyer/privacy-mask-video#readme",
  "bugs": {
    "url": "https://github.com/evan-hyer/privacy-mask-video/issues"
  },
  "keywords": [
    "web-component",
    "video",
    "privacy",
    "face-mask",
    "emoji",
    "webcodecs"
  ],
  "files": [
    "dist/",
    "src/",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Native Web Component for local video face masking",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./assets/*": "./dist/assets/*",
    "./workers/*": "./dist/workers/*"
  },
  "scripts": {
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "fixtures:verify": "node scripts/verify-fixtures.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/release-check.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test:browser": "playwright test --project=browser",
    "test:privacy": "playwright test --project=privacy",
    "test:performance": "playwright test --project=performance"
  },
  "dependencies": {
    "mediabunny": "1.61.4",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
